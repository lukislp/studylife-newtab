{
  "manifest_version": 3,
  "name": "StudyLife New Tab",
  "version": "1.1.0",
  "description": "Replaces the New Tab page with your StudyLife stats: hours this week, streak, and the next course-goal deadline.",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
